# ============================================================================
# VERHOJUST ÉPICERIE — Environment Variables
# ============================================================================
# Copy this file to `.env` and fill in your Clever Cloud MySQL credentials.
# NEVER commit the real `.env` file.
# ----------------------------------------------------------------------------

# >>> INSERT YOUR CLEVER CLOUD MYSQL CREDENTIALS BELOW <<<

VITE_DB_HOST=your-clever-cloud-mysql-host.clevercloud.com
VITE_DB_PORT=3306
VITE_DB_USER=your-clever-cloud-mysql-user
VITE_DB_PASSWORD=your-clever-cloud-mysql-password
VITE_DB_NAME=your-clever-cloud-mysql-database

# Backend API URL (Express.js or similar server that connects to MySQL)
VITE_API_URL=http://localhost:4000/api

# Set to "false" when your Express API is live to switch from mock data to real API
VITE_USE_MOCK_API=true
